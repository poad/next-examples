    "esbuild": "^0.28.2",
    "graphql-codegen-typescript-validation-schema": "^0.19.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-awscdk": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
