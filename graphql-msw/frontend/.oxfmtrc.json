{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "semi": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "endOfLine": "lf",
  "sortImports": {
    "groups": [
      ["builtin"],
      ["external"],
      ["internal"],
      ["parent", "sibling", "index"]
    ],
    "sortSideEffects": false,
    "newlinesBetween": false,
    "ignoreCase": true
  },
  "ignorePatterns": [
    "dist/*",
    "node_modules/**",
    "**/generated/**",
    "**/gql/**",
    "src/gql/**",
    "graphql.schema.json",
    "cdk.out/**",
    ".next/**",
    "out/**"
  ]
}
