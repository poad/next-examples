{
  "name": "wasm-example",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "cargo install wasm-pack --force",
    "dev": "pnpm wasm && next dev --turbopack",
    "build": "pnpm wasm && next build --webpack",
    "start": "pnpm wasm && next start",
    "analyze": "ANALYZE=true next build",
    "export": "pnpm wasm && next build",
    "wasm": "wasm-pack build --target web --no-opt wasm",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.86.0",
    "typescript": "^6.0.3"
  }
}
