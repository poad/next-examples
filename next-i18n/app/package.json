{
  "name": "next-ts-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "404": "cp out/404/index.html out/404.html",
    "test": "jest --passWithNoTests",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix",
    "clean": "rimraf build",
    "pretest": "next build",
    "postbuild": "cp out/404/index.html out/404.html",
    "post404": "cp public/favicon.ico out",
    "serve": "http-server out -p 8080"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "i18next": "^26.4.2",
    "next": "^16.4.2",
    "next-i18next": "^16.3.1",
    "next-language-detector": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@mui/icons-material": "^9.5.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "http-server": "^14.1.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "rimraf": "^6.1.3",
    "styled-jsx": "^5.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
