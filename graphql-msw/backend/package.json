    "aws-cdk": "^2.1148.1",
    "esbuild": "^0.28.2",
    "graphql-codegen-typescript-validation-schema": "^0.19.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-awscdk": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yup": "^1.7.1"
