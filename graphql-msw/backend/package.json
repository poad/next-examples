{
  "name": "@next-ts-graphql-msw-example/backend",
  "version": "0.1.0",
  "bin": {
    "backend": "bin/backend.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "clean": "tsc --build --clean",
