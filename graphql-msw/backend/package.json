    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/aws-lambda": "^4.1.0",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/introspection": "^6.1.0",
    "@graphql-codegen/jsdoc": "^4.0.1",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
