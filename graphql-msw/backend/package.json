    "generate": "graphql-codegen --config codegen.yml",
    "prebuild": "pnpm generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/aws-lambda": "^4.1.0",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/introspection": "^7.0.0",
    "@graphql-codegen/jsdoc": "^5.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@graphql-tools/graphql-file-loader": "^9.1.2",
    "@graphql-tools/load": "^9.1.3",
    "@graphql-tools/schema": "^11.0.9",
