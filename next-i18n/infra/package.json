{
  "name": "infra",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "infra": "bin/infra.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "watch": "tsc --project tsconfig.build.json -w",
    "cdk": "cdk",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "aws-cdk": "^2.1142.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "jest": {
    "roots": [
      "<rootDir>/test"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
