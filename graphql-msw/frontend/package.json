  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/typescript-msw": "^4.0.2",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@types/node": "^26.6.5",
