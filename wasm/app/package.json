{
  "name": "wasm-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm wasm && next dev --turbopack",
    "build": "pnpm wasm && next build --webpack",
    "start": "pnpm wasm && next start",
    "analyze": "ANALYZE=true next build",
    "export": "pnpm wasm && next build",
    "wasm": "wasm-pack build --target web --no-opt wasm",
    "wasm:setup": "rustup target add wasm32-unknown-unknown && (command -v wasm-pack > /dev/null || npm install --global wasm-pack@0.15.0)",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}
