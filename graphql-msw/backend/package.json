{
  "name": "@next-ts-graphql-msw-example/backend",
  "version": "0.1.0",
  "bin": {
    "backend": "bin/backend.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "clean": "tsc --build --clean",
    "lint-fix": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint",
    "generate": "graphql-codegen --config codegen.yml",
    "prebuild": "pnpm generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/aws-lambda": "^4.1.0",
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/introspection": "^5.0.2",
    "@graphql-codegen/jsdoc": "^4.0.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-resolvers": "^5.1.8",
    "@graphql-tools/graphql-file-loader": "^8.1.22",
    "@graphql-tools/load": "^8.1.19",
    "@graphql-tools/schema": "^10.1.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "graphql-codegen-typescript-validation-schema": "^0.17.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-awscdk": "^1.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yup": "^1.7.1"
